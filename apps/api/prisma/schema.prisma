generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


enum Role {
  owner
  employee
}

enum PaymentMethod {
  cash
  transfer
}

enum CashMovementType {
  income
  expense
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users            User[]
  customers        Customer[]
  services         Service[]
  sales            Sale[]
  cashMovements    CashMovement[]
  cashClosings     CashClosing[]
  businessSettings BusinessSettings?

  @@map("tenants")
}

model User {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  email     String   @unique
  password  String
  role      Role
  // Incrementado en logout para invalidar refresh tokens ya emitidos.
  // No forma parte del modelo documentado en docs/DATABASE.md porque es un
  // detalle de implementación del flujo de auth, no un campo de negocio.
  tokenVersion Int   @default(0) @map("token_version")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  sales  Sale[]
  cashClosings CashClosing[]

  @@index([tenantId])
  @@map("users")
}

model Customer {
  id        String    @id @default(uuid())
  tenantId  String    @map("tenant_id")
  name      String
  phone     String?
  notes     String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  sales  Sale[]

  @@index([tenantId])
  @@map("customers")
}

model Service {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  name            String
  price           Decimal   @db.Decimal(10, 2)
  active          Boolean   @default(true)
  durationMinutes Int?      @map("duration_minutes")
  // Color hex (p.ej. "#24406B") para distinguir servicios en agenda/listas.
  color           String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  saleItems SaleItem[]

  @@index([tenantId])
  @@map("services")
}

model Sale {
  id            String        @id @default(uuid())
  tenantId      String        @map("tenant_id")
  customerId    String?       @map("customer_id")
  employeeId    String        @map("employee_id")
  paymentMethod PaymentMethod @map("payment_method")
  total         Decimal       @db.Decimal(10, 2)
  createdAt     DateTime      @default(now()) @map("created_at")

  tenant   Tenant     @relation(fields: [tenantId], references: [id])
  customer Customer?  @relation(fields: [customerId], references: [id])
  employee User       @relation(fields: [employeeId], references: [id])
  items    SaleItem[]

  @@index([tenantId, createdAt])
  @@map("sales")
}

model SaleItem {
  id        String   @id @default(uuid())
  saleId    String   @map("sale_id")
  serviceId String   @map("service_id")
  // Precio del servicio al momento de la venta, independiente de cambios
  // futuros en services.price (docs/DATABASE.md).
  price     Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now()) @map("created_at")

  sale    Sale    @relation(fields: [saleId], references: [id])
  service Service @relation(fields: [serviceId], references: [id])

  @@index([saleId])
  @@map("sale_items")
}

model CashMovement {
  id          String            @id @default(uuid())
  tenantId    String            @map("tenant_id")
  type        CashMovementType
  amount      Decimal           @db.Decimal(10, 2)
  description String?
  createdAt   DateTime          @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@map("cash_movements")
}

// Corte de caja: snapshot inmutable del resumen del día (docs/ROADMAP.md
// v0.1). No bloquea nuevos movimientos ni ventas — es un registro de
// auditoría de "así quedó la caja al cerrar", no un lock. Único por
// tenant+día: cerrar dos veces el mismo día devuelve 409.
model CashClosing {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  date       DateTime @db.Date
  income     Decimal  @db.Decimal(10, 2)
  expense    Decimal  @db.Decimal(10, 2)
  balance    Decimal  @db.Decimal(10, 2)
  closedById String   @map("closed_by_id")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant   Tenant @relation(fields: [tenantId], references: [id])
  closedBy User   @relation(fields: [closedById], references: [id])

  @@unique([tenantId, date])
  @@index([tenantId])
  @@map("cash_closings")
}

// 1:1 con Tenant. El nombre del negocio vive en Tenant.name (existe desde
// Fase 1); esta tabla solo agrega lo que docs/DATABASE.md ya documentaba
// como pendiente (logo, colores, contacto).
model BusinessSettings {
  tenantId       String   @id @map("tenant_id")
  logo           String?
  primaryColor   String?  @map("primary_color")
  secondaryColor String?  @map("secondary_color")
  phone          String?
  address        String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("business_settings")
}
