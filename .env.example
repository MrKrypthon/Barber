# Copiar a .env y completar valores reales. Nunca commitear .env.

# --- PostgreSQL (usado por docker-compose y por Prisma) ---
POSTGRES_USER=barber
POSTGRES_PASSWORD=barber
POSTGRES_DB=barber_saas
DATABASE_URL=postgresql://barber:barber@localhost:5432/barber_saas?schema=public

# --- API (apps/api) ---
API_PORT=3001
# Orígenes permitidos para CORS, separados por coma (sin espacios ni barra
# final). Sin definir, cae a http://localhost:3000 (Web en desarrollo).
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=
JWT_REFRESH_SECRET=
# Secretos separados de los de arriba a propósito: un token de SuperAdmin
# nunca debe poder validarse contra el guard de negocios, ni viceversa.
SUPERADMIN_JWT_SECRET=
SUPERADMIN_JWT_REFRESH_SECRET=

# --- Seed del primer SuperAdmin (pnpm --filter @barber/api seed:superadmin) ---
SUPERADMIN_SEED_NAME=
SUPERADMIN_SEED_EMAIL=
SUPERADMIN_SEED_PASSWORD=

# --- WhatsApp Business Platform (Meta Cloud API, docs/DECISIONS.md ADR-011) ---
# Credenciales de la APP de Meta (una sola, compartida por todos los
# tenants). Las credenciales de CADA negocio (Phone Number ID, WABA ID,
# access token) se cargan desde la app, en Configuración, no acá.
# WHATSAPP_VERIFY_TOKEN: string que vos elegís, se configura también en el
# panel de Meta al dar de alta el webhook.
WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET: lo da Meta, se usa para verificar la firma de cada
# webhook entrante.
WHATSAPP_APP_SECRET=

# --- Web (apps/web) ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# --- Producción (docker-compose.prod.yml, docs/DEPLOYMENT.md) ---
# Dominio real del negocio (sin http/https ni barra final), usado por Nginx
# y por certbot para emitir el certificado. En desarrollo no hace falta.
DOMAIN=
# Email de contacto para Let's Encrypt (avisos de vencimiento, nada más).
CERTBOT_EMAIL=
