# Copiar a .env y completar valores reales. Nunca commitear .env.

# --- PostgreSQL (usado por docker-compose y por Prisma) ---
POSTGRES_USER=barber
POSTGRES_PASSWORD=barber
POSTGRES_DB=barber_saas
DATABASE_URL=postgresql://barber:barber@localhost:5432/barber_saas?schema=public

# --- API (apps/api) ---
API_PORT=3001
JWT_SECRET=
JWT_REFRESH_SECRET=

# --- Web (apps/web) ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
